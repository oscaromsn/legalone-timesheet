node_modules/

# Credentials. The cookie in .env is the entire credential for the account.
.env

# Tenant-bound configuration, copied from the .example files at setup and then
# filled with real names, ids and rates. Never committed:
#   aliases.json   client names — attorney-client information
#   template.json  a captured snapshot of *your* form: your user id, your rate
src/aliases.json
src/template.json

# Everything below accumulates client data by simply being used.
#
# .context/   timesheet source documents — descriptions of real client work
# fixtures/   captured HTTP traffic — real matters, contacts, ids, billing
# scripts/    per-week run scripts, written against real clients by name
#
# fixtures/ is spelled with a glob rather than a trailing slash: git does not
# descend into an excluded directory, so the negation below would not be seen.
.context/
fixtures/*
!fixtures/README.md
scripts/

# The browser profile lives in an OS application directory, not here — but if one
# is ever pointed at the repo, it holds a renewable SSO session. Never commit it.
browser/
chrome-profile/

.DS_Store
